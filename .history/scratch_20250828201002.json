pipeline {
    agent any

    stages {
        stage('w/o docker') {
            steps {
                sh '''
                echo "without docker"
                ls -la
            '''
            }
        }
                stage('w/ docker') {
                agent {
                    docker {
                    image 'node:18-alpine'
                    reuseNode true
                    }
                }    
                steps {
                sh '''
                    echo with docker
                    ls -la
                    touch container-yes.txt
                '''
                sh 'npm --version'
            }
        }
    }
}
