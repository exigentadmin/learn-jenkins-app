pipeline {
    agent any

    stages {
        stage('Build') {
            agent {
                docker {
                    image 'node:18-alpine'
                    reuseNode true
                }
            }
            steps {
                echo 'Hello World'
                sh '''
                    ls -la
                    node --version
                    npm --version
                    npm ci
                    npm run build
                    ls -la 
                '''
            }
        }
        stage('Test') {
            agent {
                docker {
                    image 'node:18-alpine'
                    reuseNode true
                }
            }
            steps {
                sh '''
                    test -f build/index.html
                    npm test
                '''
                /*
                script {               
                def statusCode = sh script: 'npm test', returnStatus: true
                if (statusCode != 0) {
                    error 'npm test failed, stopping the build'
                } else {
                    echo 'npm test passed'    
                }
                }*/
            }
        }
    }

    post {
        always {
            junit 'test-results/junit.xml'
        }
    }
}